{
  "manifest_version": 3,
  "name": "Alta-Profil → Tilda Scanner",
  "version": "14.2.2",
  "description": "Сканирование до 8 товаров параллельно + исправленный путь и автообновление из GitHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.alta-profil.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alta Scanner"
  },
  "background": {
    "service_worker": "background-v14.1.js"
  }
}
