{
  "manifest_version": 3,
  "name": "Alta-Profil → Tilda Scanner",
  "version": "14.1.0",
  "description": "Сначала тест 8 уникальных товаров, затем полный каталог; до 8 параллельных карточек.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.alta-profil.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alta Scanner"
  },
  "background": {
    "service_worker": "background-v14.1.js"
  }
}
